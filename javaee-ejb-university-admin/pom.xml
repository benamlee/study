<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ========================================== -->
    <!-- 父 POM：这是整个项目的根配置文件            -->
    <!-- packaging=pom 表示这是一个"父项目"，         -->
    <!-- 只用来管理子模块，不生成可部署的文件         -->
    <!-- ========================================== -->
    <groupId>com.university</groupId>
    <artifactId>university-admin</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>University Admin System - Parent POM</name>

    <!-- ========================================== -->
    <!-- 子模块列表：Maven 会按这个顺序编译          -->
    <!-- 顺序很重要：ejb → web → ear                -->
    <!-- 因为 web 依赖 ejb，ear 依赖 ejb+web         -->
    <!-- ========================================== -->
    <modules>
        <module>university-admin-ejb</module>
        <module>university-admin-web</module>
        <module>university-admin-ear</module>
    </modules>

    <!-- ========================================== -->
    <!-- 全局属性：所有子模块共享这些值              -->
    <!-- ========================================== -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Java 版本：使用 JDK 17 编译 -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <!-- Java EE 8 API 版本 -->
        <javaee.version>8.0.1</javaee.version>
        <!-- H2 内存数据库版本 -->
        <h2.version>2.2.224</h2.version>
    </properties>

    <!-- ========================================== -->
    <!-- 依赖版本管理：统一管理所有子模块的依赖版本  -->
    <!-- 子模块引入依赖时不需要写 version，          -->
    <!-- 继承父 POM 这里定义的 version               -->
    <!-- ========================================== -->
    <dependencyManagement>
        <dependencies>
            <!-- Java EE 8 API（provided 作用域） -->
            <!-- provided = 编译时需要，运行时由 WebSphere 提供 -->
            <dependency>
                <groupId>javax</groupId>
                <artifactId>javaee-api</artifactId>
                <version>${javaee.version}</version>
                <scope>provided</scope>
            </dependency>
            <!-- H2 数据库驱动（runtime 作用域） -->
            <!-- runtime = 编译时不需要，运行时需要 -->
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
                <scope>runtime</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ========================================== -->
    <!-- 插件管理：统一管理所有子模块的 Maven 插件  -->
    <!-- ========================================== -->
    <build>
        <pluginManagement>
            <plugins>
                <!-- Java 编译器插件 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>17</source>
                        <target>17</target>
                    </configuration>
                </plugin>
                <!-- EAR 打包插件 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-ear-plugin</artifactId>
                    <version>3.3.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
