<?xml version="1.0" encoding="UTF-8"?>
<!-- ========================================== -->
<!-- web.xml：Web 应用部署描述符                 -->
<!-- 作用：配置 Servlet、过滤器、欢迎页面等     -->
<!-- ========================================== -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    
    <!-- 应用显示名称 -->
    <display-name>University Admin Web</display-name>
    
    <!-- ========================================== -->
    <!-- 字符编码过滤器：解决中文乱码问题           -->
    <!-- 确保所有请求和响应都用 UTF-8 编码          -->
    <!-- ========================================== -->
    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>com.university.web.filter.CharacterEncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    
    <!-- ========================================== -->
    <!-- Servlet 配置                               -->
    <!-- 使用 @WebServlet 注解方式（在 Java 代码中  -->
    <!-- 通过 @WebServlet("/student/*") 配置）       -->
    <!-- 所以这里不需要再配 servlet-mapping         -->
    <!-- ========================================== -->
    
    <!-- ========================================== -->
    <!-- 欢迎页面：访问 http://localhost:9080/      -->
    <!-- university-admin/ 时默认显示 index.jsp      -->
    <!-- ========================================== -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    
    <!-- ========================================== -->
    <!-- Session 超时时间（分钟）                    -->
    <!-- ========================================== -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
    
</web-app>
